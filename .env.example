# Optional: lets the vault ask the extension to open demo-login.html.
# Autofill works without this if the extension is loaded (?pocAutofill=1 on the demo page).
# Copy the ID from chrome://extensions after loading the extension/ folder unpacked.
VITE_POC_EXTENSION_ID=

# Phase 118 — Assisted Mapping provider mode for the Hub (NOT the API key).
# mock = local/CI MockMappingLlmProvider
# openai = call Supabase Edge Function propose-field-mappings (server holds the key)
# Omit to auto-select: openai when Supabase is configured, else mock.
# VITE_ASSISTED_MAPPING_PROVIDER=openai

# ---------------------------------------------------------------------------
# Phase 118 OpenAI API key — SERVER / EDGE ONLY (never VITE_*, never commit)
# Place the secret via Supabase CLI or Dashboard secrets — see team-Yuri/dev-phase118.md
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ---------------------------------------------------------------------------
